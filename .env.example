# Easiest: paste a key on the app's Models page. Or put it here (Docker reads .env),
# or: python3 -m asic_agent models add-key PROVIDER (writes the file below).
# Or copy to ~/.config/asic-agent/secrets.env (recommended, outside the repo,
# chmod 600) or to .env in the repo root (git-ignored). Only the keys for the
# providers you use are needed. Never commit real keys.

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
AZURE_OPENAI_API_KEY=

# Optional overrides of config/llm.toml
# LLM_PROVIDER=groq
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_FALLBACK_PROVIDER=groq
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# EMBEDDING_PROVIDER=none
# EMBEDDING_MODEL=
# ASIC_AGENT_LOG_LEVEL=INFO

# Web app (scripts/start_app.sh)
# HOST=127.0.0.1            # anything else requires ASIC_AGENT_TOKEN
# PORT=8080
# ASIC_AGENT_TOKEN=         # long random string (openssl rand -hex 24); needed when the
#                           # app is reachable beyond this machine (see docs/DOCKER.md).
#                           # Sign in once with http://host:port/?token=...
# RAG_PORT=8090             # knowledge service (always 127.0.0.1)
